<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="0.0" minWidth="0.0" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unina.uninamulticloud.boundary.RicercaBoundary">
    <top>
        <HBox alignment="CENTER" minWidth="0.0" prefHeight="150.0" prefWidth="1280.0" spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
            </padding>
            <children>
                <!-- SINISTRA: Tasto Indietro -->
                <HBox alignment="TOP_CENTER" minWidth="-Infinity">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onIndietro" prefHeight="36.0" prefWidth="100.0" styleClass="backgen-button" stylesheets="@../css/style.css" text="Indietro" textFill="WHITE">
                            <graphic>
                                <ImageView fitHeight="12.0" fitWidth="12.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/WBack.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                     <HBox.margin>
                        <Insets top="10.0" />
                     </HBox.margin>
                        </Button>
                    </children>
                </HBox>

                <Region minWidth="0.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />

                <!-- CENTRO: Barra di ricerca elastica -->
                <HBox alignment="CENTER" minWidth="0.0" spacing="12.0" HBox.hgrow="ALWAYS">
                    <children>
                        <TextField fx:id="barraRicercaTextField" maxWidth="700.0" minWidth="60.0" prefWidth="600.0" promptText="Cerca" styleClass="barraRicercaTextField" stylesheets="@../css/style.css" HBox.hgrow="ALWAYS" />
                        <Button fx:id="cercaButton" maxWidth="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onEseguiRicerca" prefHeight="38.0" prefWidth="100.0" styleClass="cerca-button" stylesheets="@../css/style.css" text="Cerca">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" opacity="0.46" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/search.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>

                <Region minWidth="0.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />

                <!-- DESTRA: Contenitore pronto per i filtri -->
                <HBox fx:id="filtriBox" alignment="CENTER_RIGHT" minWidth="-Infinity" spacing="10.0">
               <children>
                  <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" style="-fx-spacing: 5;">
                     <children>
                        <ComboBox fx:id="criterioComboBox" minWidth="120.0" prefHeight="25.0" prefWidth="129.0" promptText="Cerca per:" styleClass="filter-combo" stylesheets="@../css/style.css" />
                        <ComboBox fx:id="oggettoComboBox" minWidth="120.0" prefHeight="25.0" prefWidth="129.0" promptText="Cerca in:" styleClass="filter-combo" stylesheets="@../css/style.css" />
                     </children>
                  </VBox>
               </children></HBox>
            </children>
        </HBox>
    </top>
   <center>
      <TableView fx:id="risultatiTableView" prefHeight="520.0" prefWidth="1415.0" stylesheets="@../css/style.css" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="titoloTableColumn" maxWidth="1.7976931348623157E308" prefWidth="500.0" text="Titolo" />
            <TableColumn fx:id="autoreTableColumn" prefWidth="300.0" text="Autore" />
            <TableColumn fx:id="durataTableColumn" prefWidth="200.0" text="Durata" />
         </columns>
         <BorderPane.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>
