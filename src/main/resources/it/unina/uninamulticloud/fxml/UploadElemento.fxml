<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unina.uninamulticloud.boundary.UploadElementoBoundary">
   <center>
      <VBox alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" spacing="20.0" BorderPane.alignment="CENTER">
          <padding>
              <Insets bottom="20.0" left="20.0" right="20.0" />
          </padding>

          <Label style="-fx-font-size: 30px; -fx-font-weight: bold;" text="Carica elemento multimediale">
            <padding>
               <Insets bottom="80.0" />
            </padding></Label>

          <HBox alignment="CENTER" spacing="20">
              <VBox alignment="CENTER" spacing="5">
                  <Button fx:id="btnSelezionaFile" onAction="#onSelezionaFile" style="-fx-background-color: black;" text="Seleziona file" textFill="WHITE">
                  <font>
                     <Font size="13.0" />
                  </font></Button>
                  <Label fx:id="lblNomeFile" style="-fx-font-size: 11px;" text="Nessun file selezionato" />
              </VBox>

              <VBox alignment="CENTER" spacing="5">
                  <Button fx:id="btnSelezionaCopertina" onAction="#onSelezionaCopertina" style="-fx-background-color: black;" text="Seleziona copertina" textFill="WHITE">
                  <font>
                     <Font size="13.0" />
                  </font></Button>
                  <Label fx:id="lblNomeCopertina" style="-fx-font-size: 11px;" text="Nessuna copertina selezionata" />
              </VBox>
          </HBox>

          <HBox alignment="CENTER" spacing="80.0">
            <TextField fx:id="txtTitolo" minWidth="200.0" promptText="Titolo *" />
            <TextArea fx:id="txtDescrizione" prefRowCount="4" promptText="Descrizione" />
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
          </HBox>
          <Button onAction="#onCarica" prefWidth="200" style="-fx-background-color: black;" styleClass=".back-button" stylesheets="@../css/style.css" text="CARICA" textFill="WHITE">
            <font>
               <Font size="14.0" />
            </font></Button>
      </VBox>
   </center>
</BorderPane>
