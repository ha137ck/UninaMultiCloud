<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="cardRoot" maxWidth="175.0" prefWidth="175.0" spacing="6.0" styleClass="media-card" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unina.uninamulticloud.boundary.MediaCardBoundary">

    <!-- RIQUADRO QUADRATO CON COPERTINA, ETICHETTA E PLAY -->
    <StackPane maxHeight="175.0" maxWidth="175.0" minHeight="175.0" minWidth="175.0" prefHeight="175.0" prefWidth="175.0" styleClass="media-card-cover">
        <children>
            <ImageView fx:id="coverImageView" fitHeight="175.0" fitWidth="175.0" pickOnBounds="true" />

            <Label fx:id="badgeLabel" styleClass="media-card-badge" text="Elemento" StackPane.alignment="TOP_LEFT">
                <StackPane.margin>
                    <Insets left="12.0" top="10.0" />
                </StackPane.margin>
            </Label>

            <Label styleClass="media-card-play" text="▶" StackPane.alignment="BOTTOM_RIGHT">
                <StackPane.margin>
                    <Insets bottom="8.0" right="12.0" />
                </StackPane.margin>
            </Label>
        </children>
    </StackPane>

    <!-- TITOLO E DESCRIZIONE SOTTO LA CARD -->
    <Label fx:id="titoloLabel" maxWidth="175.0" styleClass="media-card-title" text="Titolo" />
    <Label fx:id="descrizioneLabel" maxHeight="36.0" maxWidth="175.0" styleClass="media-card-desc" text="Descrizione" wrapText="true" />
</VBox>