<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unina.uninamulticloud.boundary.LibreriaBoundary">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16">
            <padding>
                <Insets bottom="8" left="24" right="24" top="16" />
            </padding>
            <Button onAction="#onTornaAllaHome" text="← Home" />
            <Label text="La mia libreria" />
        </HBox>
    </top>
    <center>
        <TableView fx:id="tabellaElementi">
            <columns>
                <TableColumn fx:id="colTitolo" prefWidth="183.99999696016312" text="Titolo" />
                <TableColumn fx:id="colTipo" prefWidth="188.20001220703125" text="Tipo" />
                <TableColumn fx:id="colDurata" prefWidth="129.4000244140625" text="Durata" />
                <TableColumn fx:id="colFormato" prefWidth="90" text="Formato" />
                <TableColumn fx:id="colDataCreazione" prefWidth="160" text="Caricato il" />
                <TableColumn fx:id="immagineCopertina" text="Immagine" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <Label fx:id="lblMessaggio">
            <padding>
                <Insets bottom="16" left="24" right="24" top="8" />
            </padding>
        </Label>
    </bottom>
</BorderPane>
