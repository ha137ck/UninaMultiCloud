<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unina.uninamulticloud.boundary.LibreriaBoundary">
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="24" bottom="8" left="24"/>
            </padding>
            <Button text="← Home" onAction="#onTornaAllaHome"/>
            <Label text="La mia libreria"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tabellaElementi">
            <columns>
                <TableColumn fx:id="colTitolo" text="Titolo" prefWidth="320"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="90"/>
                <TableColumn fx:id="colDurata" text="Durata" prefWidth="90"/>
                <TableColumn fx:id="colFormato" text="Formato" prefWidth="90"/>
                <TableColumn fx:id="colDataCreazione" text="Caricato il" prefWidth="160"/>
                <TableColumn fx:id="immagineCopertina" text="immagine"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <Label fx:id="lblMessaggio">
            <padding>
                <Insets top="8" right="24" bottom="16" left="24"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>